# iCamp environment template
# Never place real secrets in this file.

# Public-safe values compiled into the web interface.
NEXT_PUBLIC_APP_NAME=iCamp
NEXT_PUBLIC_APP_ENV=development

# Server/runtime identity.
ICAMP_APP_NAME=iCamp
ICAMP_APP_ENV=development
ICAMP_APP_VERSION=0.1.0
ICAMP_BUILD_SHA=local
ICAMP_RELEASE_ID=local
# ICAMP_DEPLOYED_AT=2026-10-04T22:00:00Z
ICAMP_LOG_LEVEL=debug

# Feature flags. Development defaults are safe when omitted.
ICAMP_FEATURE_IT_ANALYSIS_WORKSPACE=true
ICAMP_FEATURE_PUBLIC_STATUS_PAGE=true
ICAMP_FEATURE_EXTERNAL_WATCHDOG=false

# Server-only PostgreSQL connection.
# Never expose this value through NEXT_PUBLIC_* variables.
# Set DATABASE_URL in the server/hosting secret store.
# DATABASE_URL=<server-only PostgreSQL connection string>

# Server-only media/object storage adapter.
# Public media can resolve without a secret; private access and uploads require one.
ICAMP_MEDIA_STORAGE_PROVIDER=supabase
ICAMP_SUPABASE_URL=https://<project-ref>.supabase.co
ICAMP_MEDIA_SIGNED_URL_SECONDS=300
# ICAMP_SUPABASE_SECRET_KEY=<server-only Supabase secret key>

# Provider-neutral communications adapter.
# Build 009 defaults to the free local mock provider; real provider secrets arrive later.
ICAMP_COMMUNICATIONS_PROVIDER=mock

# Voice/IVR gateway. Build 010 uses the sandbox mock adapter by default.
ICAMP_VOICE_PROVIDER=mock
ICAMP_VOICE_WEBHOOK_TOLERANCE_SECONDS=300
# Required only when accepting inbound signed webhook traffic.
# ICAMP_VOICE_WEBHOOK_SECRET=<server-only secret, at least 16 characters>

# SMS/MMS conversation gateway. Build 012 uses the sandbox mock adapter by default.
ICAMP_MESSAGING_PROVIDER=mock
ICAMP_MESSAGING_WEBHOOK_TOLERANCE_SECONDS=300
# Required only when accepting inbound signed SMS/MMS webhook traffic.
# ICAMP_MESSAGING_WEBHOOK_SECRET=<server-only secret, at least 16 characters>
