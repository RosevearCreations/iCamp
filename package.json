{
  "name": "icamp",
  "version": "0.1.0",
  "private": true,
  "description": "iCamp2027 campground operations platform",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/apply-database-migrations.mjs",
    "db:verify": "psql \"$DATABASE_URL\" -X --no-psqlrc -v ON_ERROR_STOP=1 -f database/verify/0001_core_multi_property_and_refresh.sql"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
