{
  "name": "icamp",
  "version": "0.1.0",
  "private": true,
  "description": "iCamp2027 campground operations platform",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:ql252-public-proof": "node scripts/ql252-public-proof-audit.mjs",
    "audit:ql253-public-proof": "node scripts/ql253-immutable-public-retest.mjs",
