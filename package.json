    "audit:ql255-six-app-proof": "node scripts/ql255-six-app-public-recheck.mjs",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/apply-database-migrations.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "build187:verify": "node scripts/verify-build187-security-incidents.mjs",
    "build188:verify": "node scripts/verify-build188-access-reconciliation.mjs",
    "build189:verify": "node scripts/verify-build189-offline-sync.mjs",
    "build190:verify": "node scripts/verify-build190-staff-readiness.mjs",
    "build191:verify": "node scripts/verify-build191-vendor-service.mjs",
    "build192:verify": "node scripts/verify-build192-store-ops.mjs",
    "build194:verify": "node scripts/verify-build194-command-views.mjs",
    "build198:restore-drill": "node scripts/build198-recovery-drill.mjs",
    "build198:db-budget": "node scripts/build198-db-budget.mjs",
    "build198:http-budget": "node scripts/build198-performance-probe.mjs",
    "build200:source-audit": "node scripts/build200-pilot-source-audit.mjs",
    "build201:handshake-drill": "node scripts/build201-nonproduction-handshake-drill.mjs",
    "build202:scoped-witness": "node scripts/build202-scoped-test-witness.mjs",
    "build203:runbook": "node scripts/build203-nonproduction-runbook.mjs",
    "build204:ci-contract": "node scripts/verify-build204-ci-contract.mjs",
    "build205:ci-diagnostics": "node scripts/build205-ci-runtime-diagnostics.mjs",
    "auth:verify": "node scripts/verify-auth-lifecycle.mjs",
    "authz:verify": "node scripts/verify-authorization-lifecycle.mjs",
    "audit:verify": "node scripts/verify-audit-lifecycle.mjs",
    "jobs:verify": "node scripts/verify-background-jobs-lifecycle.mjs",
    "media:verify": "node scripts/verify-media-lifecycle.mjs",
    "communications:verify": "node scripts/verify-communications-lifecycle.mjs",
    "voice:verify": "node scripts/verify-voice-lifecycle.mjs",
    "dtmf:verify": "node scripts/verify-dtmf-lifecycle.mjs",
    "messaging:verify": "node scripts/verify-messaging-lifecycle.mjs",
    "identity:verify": "node scripts/verify-channel-verification-lifecycle.mjs",
    "consent:verify": "node scripts/verify-messaging-consent-lifecycle.mjs",
    "parity:verify": "node scripts/verify-workflow-parity.mjs",
    "demo:seed": "node scripts/seed-demo-campground.mjs",
    "demo:verify": "node scripts/verify-demo-campground.mjs",
    "e2e:test": "npm run build && playwright test"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "@playwright/test": "1.64.0"
  }
}
